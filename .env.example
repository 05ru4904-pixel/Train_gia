# --- Telegram ---
# Токен основного бота (тот, что открывает Mini App). @BotFather -> /newbot
BOT_TOKEN=1234567890:AAaaBBbbCCccDDddEEeeFFffGGgg
# Токен ОТДЕЛЬНОГО админ-бота (управление базой заданий)
ADMIN_BOT_TOKEN=9876543210:ZZzzYYyyXXxxWWwwVVvvUUuuTTtt
# Telegram ID администраторов через запятую. Свой ID можно узнать у @userinfobot
ADMIN_IDS=123456789,987654321

# --- Mini App ---
# ПУБЛИЧНЫЙ https-адрес приложения + путь /app. Заполнять ПОСЛЕ первого деплоя.
# Только https, иначе Telegram отклонит кнопку (playbook 2.5).
WEBAPP_URL=https://your-app.up.railway.app/app

# --- База данных ---
# Railway -> сервис Postgres -> Variables -> DATABASE_URL (раскрыть глазом и скопировать
# ЦЕЛИКОМ реальное значение, не ссылку ${{...}} — playbook 2.3).
# Брать ПУБЛИЧНЫЙ адрес (...proxy.rlwy.net), внутренний часто не резолвится (playbook 2.4).
DATABASE_URL=postgresql://postgres:password@shortline.proxy.rlwy.net:12345/railway

# --- Прочее ---
# Порт HTTP-сервера. На Railway подставляется автоматически.
PORT=8080
# Поднимать админ-бота внутри основного процесса (один сервис на Railway).
# false — если админ-бот запускается отдельным сервисом через `python admin.py`.
RUN_ADMIN_BOT_INLINE=true
